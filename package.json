{
  "name": "pi-academiccloud",
  "version": "1.0.0",
  "description": "Pi extension for Academic Cloud AI models",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check-upstream": "npx tsx scripts/check-upstream-models.ts"
